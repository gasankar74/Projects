# Top-level .env, read by Docker Compose (not by the app). Copy to .env on the server; never commit it.
# The app's own settings live in backend/.env (see backend/.env.example).
MERIDIAN_DB_PASSWORD=change-me-to-a-long-random-string

# Behind Nginx Proxy Manager or another reverse proxy: the address and port the web app listens on, for the proxy
# to forward to. Leave unset with Tailscale serve (then it listens on 127.0.0.1:3000 only).
# MERIDIAN_WEB_BIND=192.168.68.153
# MERIDIAN_WEB_PORT=3000
