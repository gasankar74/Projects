# Nightly encrypted database backup for Elevate.
# Install: sudo cp deploy/meridian-backup.{service,timer} /etc/systemd/system/
#          (edit User= and WorkingDirectory= below), then: sudo systemctl enable --now meridian-backup.timer
[Unit]
Description=Elevate database backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=meridian
WorkingDirectory=/opt/meridian-planner
Environment=MERIDIAN_BACKUP_DIR=/srv/backups/meridian
ExecStart=/opt/meridian-planner/deploy/backup.sh
