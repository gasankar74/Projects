# Copy to backend/.env for local development. Never commit real secrets.
MERIDIAN_DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian
# Generate with: python -m app.cli genkey   (comma-separate several keys to rotate; the first encrypts)
MERIDIAN_TOKEN_ENCRYPTION_KEYS=
# From Google Cloud console > APIs & Services > Credentials > OAuth client (Web application)
MERIDIAN_GOOGLE_CLIENT_ID=
MERIDIAN_GOOGLE_CLIENT_SECRET=
MERIDIAN_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
MERIDIAN_FRONTEND_URL=http://localhost:3000
MERIDIAN_COOKIE_SECURE=false
# Local-only email sign-in without Google. Never enable in production.
MERIDIAN_DEV_LOGIN_ENABLED=true

# Optional: public HTTPS address of the API (e.g. a Tailscale Funnel URL). When set, Google sends push
# notifications to {PUBLIC_URL}/webhooks/google and calendar changes arrive within seconds; otherwise every 10 min.
MERIDIAN_PUBLIC_URL=

# AI assistant. "ollama" (default: runs on your own server, nothing leaves it), "claude" (Anthropic API) or "none".
MERIDIAN_AI_PROVIDER=ollama
# Inside Docker Compose, Ollama on the host is reached at http://host.docker.internal:11434 (set in docker-compose.yml).
MERIDIAN_OLLAMA_URL=http://localhost:11434
MERIDIAN_OLLAMA_MODEL=qwen3:8b
# Let qwen3 "think" before answering: better at multi-step requests, slower.
MERIDIAN_OLLAMA_THINK=false
# Only for MERIDIAN_AI_PROVIDER=claude. Kept on the server; never sent to the browser.
MERIDIAN_ANTHROPIC_API_KEY=
MERIDIAN_CLAUDE_MODEL=claude-opus-5-5
MERIDIAN_AI_TIMEOUT_S=120

# Production safety checks and logs (docker-compose.prod.yml sets these for you).
MERIDIAN_ENV=development
MERIDIAN_LOG_FORMAT=text
MERIDIAN_RATE_LIMITS_ENABLED=true

# Email for alerts and the daily digest. Gmail: turn on 2-Step Verification and create an app password.
MERIDIAN_SMTP_HOST=
MERIDIAN_SMTP_PORT=587
MERIDIAN_SMTP_USER=
MERIDIAN_SMTP_PASSWORD=
MERIDIAN_EMAIL_FROM=
# Browser notifications: generate with `python -m app.cli vapid`. Needs HTTPS (your Tailscale address) or localhost.
MERIDIAN_VAPID_PUBLIC_KEY=
MERIDIAN_VAPID_PRIVATE_KEY=
MERIDIAN_VAPID_SUBJECT=mailto:you@example.com
