# Copy to backend/.env for local development. Never commit real secrets.
AASHA_DATABASE_URL=postgresql+psycopg://aasha:aasha@localhost:5432/aasha
# Generate with: python -m app.cli genkey   (comma-separate several keys to rotate; the first encrypts)
AASHA_TOKEN_ENCRYPTION_KEYS=
# From Google Cloud console > APIs & Services > Credentials > OAuth client (Web application)
AASHA_GOOGLE_CLIENT_ID=
AASHA_GOOGLE_CLIENT_SECRET=
AASHA_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AASHA_FRONTEND_URL=http://localhost:3000
AASHA_COOKIE_SECURE=false
# Local-only email sign-in without Google. Never enable in production.
AASHA_DEV_LOGIN_ENABLED=true
